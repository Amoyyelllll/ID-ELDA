<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Creative Developer Portfolio Card</title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
  
  <style>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #0f172a;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Inter', sans-serif;
      color: #1e293b;
      padding: 20px;
    }

    h2, h3 {
      font-family: 'Poppins', sans-serif;
    }

    /* Layout */
    .main-container {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    /* Portfolio Card */
    .portfolio-card {
      background-color: #ffffff;
      max-width: 440px;
      width: 100%;
      position: relative;
      overflow: hidden;
      padding: 30px;
      border-radius: 6px;
      box-shadow: 0 10px 25px 5px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
    }

    .portfolio-card:hover {
      transform: translateY(-4px);
    }

    .banner-strip {
      height: 90px;
      background-color: #e11d48;
      margin: -30px -30px 0 -30px;
    }

    /* Header Section */
    .card-header {
      text-align: center;
    }

    .avatar-wrapper {
      display: flex;
      justify-content: center;
    }

    .dev-avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
      margin-top: -50px;
      border: 4px solid #ffffff;
      position: relative;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .dev-name {
      font-size: 20px;
      font-weight: 700;
      color: #0f172a;
      margin-top: 10px;
    }

    .dev-nim {
      font-size: 13px;
      color: #64748b;
      margin-bottom: 8px;
    }

    .title-badge-group {
      margin-bottom: 16px;
    }

    .dev-title {
      font-size: 13px;
      color: #475569;
      font-weight: 500;
      margin-bottom: 6px;
    }

    .status-pill {
      display: inline-block;
      background-color: #dcfce7;
      color: #15803d;
      font-size: 11px;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 9999px;
    }

    /* Body Section */
    .card-body {
      margin-top: 16px;
      padding: 0 6px; 
    }

    .bio-text {
      font-size: 13px;
      color: #475569;
      line-height: 1.5;
      margin-bottom: 20px;
      text-align: center;
    }

    .section-title {
      font-size: 14px;
      font-weight: 600;
      color: #0f172a;
      margin-bottom: 10px;
      margin-top: 16px;
    }

    /* Skills Table */
    .skills-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      margin-bottom: 16px;
    }

    .skills-table th, 
    .skills-table td {
      padding: 10px 12px;
      text-align: left;
    }

    .skills-table th {
      background-color: #f8fafc;
      color: #334155;
      font-weight: 600;
    }

    .skills-table tbody tr {
      border-bottom: 1px solid #e2e8f0;
    }

    .skills-table tbody tr:nth-child(even) {
      background-color: #f1f5f9;
    }

    /* Social Links */
    .social-list {
      list-style: none;
      display: flex;
      gap: 10px;
      padding: 0;
      margin-bottom: 20px;
      justify-content: center;
    }

    .social-link {
      display: inline-block;
      background-color: #f1f5f9;
      padding: 6px 14px;
      border-radius: 6px;
      font-size: 12px;
      color: #475569;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s ease;
    }

    .social-link:hover {
      background-color: #e11d48;
      color: #ffffff;
    }

    /* Card Actions (Buttons) */
    .card-actions {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }

    .btn-primary, 
    .btn-outline {
      flex: 1;
      text-align: center;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .btn-primary {
      background-color: #e11d48;
      color: #ffffff;
    }

    .btn-primary:hover {
      background-color: #be123c;
      box-shadow: 0 4px 12px rgba(225, 29, 72, 0.3);
    }

    .btn-outline {
      background-color: transparent;
      border: 2px solid #e11d48;
      color: #e11d48;
    }

    .btn-outline:hover {
      background-color: #fff1f2;
    }

    .btn-primary:active, 
    .btn-outline:active, 
    .social-link:active {
      transform: scale(0.98);
    }

    /* Footer Section */
    .card-footer {
      border-top: 1px solid #f1f5f9;
      margin-top: 20px;
      padding-top: 12px;
      text-align: center;
    }

    .card-footer p {
      font-size: 11px;
      color: #94a3b8;
    }
  </style>
</head>
<body>

  <main class="main-container">
    <article class="portfolio-card">
      
      <!-- Banner -->
      <div class="banner-strip"></div>
      
      <!-- Header -->
      <header class="card-header">
        <div class="avatar-wrapper">
          <img class="dev-avatar" src="https://lh3.googleusercontent.com/d/1lrjUyJzGBQa-YJ7TYEUmRqFcoNzlVshv" alt="Elda Tia Tira Florensia">
        </div>
        <h2 class="dev-name">Elda Tia Tira Florensia</h2>
        <p class="dev-nim">1710625004</p>
        <div class="title-badge-group">
          <p class="dev-title">Junior Web Developer & UI Designer</p>
          <span class="status-pill">Available for Hire</span>
        </div>
      </header>

      <!-- Body -->
      <section class="card-body">
        <p class="bio-text">
          Passionate web developer specializing in semantic HTML and clean CSS styling.
          Focused on building responsive, accessible, and user-centric web applications.
        </p>

        <h3 class="section-title">Technical Expertise</h3>
        <table class="skills-table">
          <thead>
            <tr>
              <th>Skill / Tool</th>
              <th>Proficiency</th>
              <th>Projects</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>HTML5 & CSS3</td>
              <td>Advanced</td>
              <td>12+</td>
            </tr>
            <tr>
              <td>JavaScript (ES6+)</td>
              <td>Intermediate</td>
              <td>8+</td>
            </tr>
            <tr>
              <td>Tailwind / UI Design</td>
              <td>Intermediate</td>
              <td>5+</td>
            </tr>
          </tbody>
        </table>

        <h3 class="section-title">Connect With Me</h3>
        <ul class="social-list">
          <li><a href="https://github.com" target="_blank" class="social-link">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/elda-tia-tira-florensia-347985379?utm_source=share_via&utm_content=profile&utm_medium=member_android" target="_blank" class="social-link">LinkedIn</a></li>
          <li><a href="https://www.instagram.com/elldaatiatiraflorensia?rpxt=MWVqemN2c3l6cnltZQ==" target="_blank" class="social-link">Website</a></li>
        </ul>
      </section>

      <!-- Actions -->
      <footer class="card-actions">
        <a href="mailto:eldatiaflorenc@gmail.com" class="btn-primary">Hire Me</a>
        <a href="https://youtu.be/muOQuAidv-k?si=ke09lIzZho2vGVA4" target="_blank" class="btn-outline">Download CV</a>
      </footer>

      <!-- Card Footer -->
      <div class="card-footer">
        <p>Portfolio Card 2026 Built with Pure CSS</p>
      </div>

    </article>
  </main>

</body>
</html>
